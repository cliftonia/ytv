[Unit]
Description=Serve the mirrored YTV ad reels to the televisions on :4245 (serve_ads.py)
After=network-online.target

[Service]
# Same tools directory as ytv-ads.service. The mirror itself is filled by ytv-ads (mirror_ads.py).
ExecStart=/usr/bin/python3 %h/ytv-foreign/tools/ads-pool/serve_ads.py --bind 0.0.0.0:4245 --dir %h/.cache/ytv-ads/mirror
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
