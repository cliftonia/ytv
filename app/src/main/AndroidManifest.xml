<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Needed to hand a downloaded build to Android's installer. It does NOT allow a silent
      install: the system dialog still appears and the viewer still confirms it, which is the
      point - a background download that could install itself is exactly what that dialog exists
      to prevent. The device also has to have "install unknown apps" granted to this app once.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- singleTask, because libmpv is one handle per process: a second launch while the
             app is running (the launcher, adb, an intent) would create a second MainActivity in
             the same process, whose MPVLib.create against the live handle exits the process -
             cleanly, with no crash report, which read as the television spontaneously going
             back to the home screen. singleTask re-delivers the launch to the existing
             activity instead. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    
        <!-- Experiment harness only: plays one clip through libmpv so its frame pacing can be
             compared against Media3 on the same content and panel. Exported so it can be driven
             from adb; this app is sideloaded and never published. -->
        <activity
            android:name=".MpvTestActivity"
            android:exported="true"
            android:launchMode="singleTask" />


        <!-- Hands the downloaded apk to the installer as a content:// URI. A file:// one has
             thrown FileUriExposedException since Android 7, and the installer is another app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

</application>
</manifest>
