<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted ONLY for the publisher on the local network. Everything else,
  including the googlevideo CDN that stream URLs point at, must use HTTPS - this device runs
  on untrusted Wi-Fi in a car, so a blanket usesCleartextTraffic would let anything on the
  network path inject stream URLs straight into the player.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.203</domain>
    </domain-config>
</network-security-config>
