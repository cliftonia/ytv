<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Merged over the main manifest by the debug variant; release never sees it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Experiment harness only: plays one clip through libmpv so its frame pacing can be
             compared against Media3 on the same content and panel. Exported so it can be driven
             from adb - which is exactly why it lives in the debug source set: an exported
             activity that plays any url it is handed has no business in the build the
             televisions install. -->
        <activity
            android:name=".MpvTestActivity"
            android:exported="true"
            android:launchMode="singleTask" />
    </application>
</manifest>
